{
  "$schema": "vscode://schemas/color-theme",
  "name": "sample-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#102030",
    "editorWidget.background": "#203040",
    "input.background": "#FFFFFF",
    "panel.background": "#182838",
    "editor.foreground": "#DDEEFF",
    "descriptionForeground": "#89A",
    "input.placeholderForeground": "#FFFFFF",
    "textLink.foreground": "#66AAFF",
    "activityBarBadge.background": "#22CC88",
    "button.background": "#FFFFFF",
    "testing.iconPassed": "#44DD77",
    "gitDecoration.addedResourceForeground": "#55CC77",
    "editorWarning.foreground": "#FFCC55",
    "errorForeground": "#FF6677",
    "editorError.foreground": "#000000",
    "contrastBorder": "#AABBCC",
    "editorGroup.border": "#667788",
    "focusBorder": "#55AAFF",
    "editor.selectionBackground": "#FF000080",
    "editor.selectionForeground": "#FFFFFF",
    "statusBar.background": "#080C10",
    "statusBar.foreground": "#F0F4F8",
    "statusBar.border": "#708090",
    "sideBar.background": "#182028",
    "sideBar.border": "#667788",
    "sideBarTitle.foreground": "#77BBFF",
    "editorLineNumber.foreground": "#778899",
    "diffEditor.insertedLineBackground": "#143820",
    "gitDecoration.deletedResourceForeground": "#FF8899",
    "diffEditor.removedLineBackground": "#401820",
    "editorInfo.foreground": "#77BBFF",
    "editor.lineHighlightBackground": "#182C40",
    "diffEditor.insertedTextBackground": "#286040",
    "diffEditor.removedTextBackground": "#703040"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#7890A0" } },
    { "scope": "keyword.control", "settings": { "foreground": "#123456" } },
    { "scope": "string.quoted", "settings": { "foreground": "#77DD99" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#FFAA00" } },
    { "scope": "constant", "settings": { "foreground": "#CC77FF" } },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#66BBFF" }
    },
    { "scope": "entity.name.class", "settings": { "foreground": "#55DDCC" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#DDEEFF" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#D090FF" } },
    { "scope": "keyword.control", "settings": { "foreground": "#ABCDEF" } }
  ]
}
