node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
.talaria/
.hermes/

# Ideation working records contain live local probes; only the scrubbed
# artifact under docs/ideation/ is public-safe.
.claude/saga/
# Per-machine Claude Code preferences. Ignored rather than merely uncommitted:
# an untracked file that nothing ignores is still visible to tooling that walks
# the working tree, and one such build swept this into a release tarball.
.claude/settings.local.json
# Machine-local saga tooling preferences (engine second-opinion choices).
.saga/

# Local agent-tool state; also keeps `npm run check` from linting it.
.serena/
.vscode/
.idea/

# Python (ADR-0004).
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Recorded frame-log corpora (R29): real sessions may carry content the
# redaction deny-set missed, so they never enter version control. Committed
# test fixtures are small synthetic frames checked in individually, not
# whole corpora.
corpora/
tests/**/corpora/

# Machine-local Qwen CLI preferences, written when an external agent runs here.
.qwen/
