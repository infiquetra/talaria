{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiquetra.github.io/talaria/acceptance/v0.6.1/artifact-manifest.schema.json",
  "title": "Talaria v0.6.1 generated acceptance artifact manifest",
  "description": "JSON Schema validates document shape only. Counts, candidate binding, receipt digests, the no-waiver READY rule, and the applies_to_candidate attestation logic are enforced by the verifier in scripts/acceptance/v050_receipt.py and the generic version validation in tests/docs/test_acceptance_versions.py. expected_receipts is a parameter supplied at record time, never a constant here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "gate_id",
    "generated_command",
    "status",
    "recorded_at",
    "harness_commit",
    "candidate",
    "counts",
    "receipts",
    "install_receipts",
    "results_document",
    "notes_document"
  ],
  "properties": {
    "$schema": {"const": "./artifact-manifest.schema.json"},
    "schema_version": {"const": "talaria-v0.6.1-artifact-manifest-v1"},
    "gate_id": {"const": "v0-6-1-daily-driver"},
    "generated_command": {"type": "string", "minLength": 1},
    "status": {"const": "complete"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "version", "wheel_filename", "wheel_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"const": "0.6.1"},
        "wheel_filename": {"type": "string", "minLength": 1},
        "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_receipts",
        "install_receipts",
        "item_receipts",
        "item_verdicts",
        "invalid_item_receipts"
      ],
      "properties": {
        "expected_receipts": {"type": "integer", "minimum": 1},
        "install_receipts": {"type": "integer", "minimum": 1},
        "item_receipts": {"type": "integer", "minimum": 1},
        "item_verdicts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocked", "fail", "pass", "reserved"],
          "properties": {
            "blocked": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "pass": {"type": "integer", "minimum": 1},
            "reserved": {"type": "integer", "minimum": 0}
          }
        },
        "invalid_item_receipts": {"const": 0}
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_path",
          "receipt_sha256",
          "checklist_item",
          "tester",
          "verdict",
          "candidate_commit_sha",
          "applies_to_candidate"
        ],
        "properties": {
          "receipt_path": {"type": "string", "minLength": 1},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checklist_item": {
            "type": "string",
            "pattern": "^live-(0[1-9]|1[0-9]|2[0-3])$"
          },
          "tester": {
            "enum": ["dedicated-tester", "worker-lane-a", "worker-lane-b", "controller"]
          },
          "verdict": {"enum": ["pass", "fail", "blocked", "reserved"]},
          "candidate_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "applies_to_candidate": {
            "type": "string",
            "minLength": 4,
            "description": "The literal `same` when the receipt's candidate_commit_sha equals the candidate's, otherwise a non-empty sentence naming the unchanged surfaces since that commit; the verifier enforces which of the two is required."
          }
        }
      }
    },
    "install_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_path", "receipt_sha256", "tester"],
        "properties": {
          "receipt_path": {"type": "string", "minLength": 1},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tester": {"const": "operator"}
        }
      }
    },
    "results_document": {"type": "string", "minLength": 1},
    "notes_document": {"type": "string", "minLength": 1}
  }
}