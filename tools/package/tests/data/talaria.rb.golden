class Talaria < Formula
  desc "Terminal client for the Hermes agent gateway"
  homepage "https://github.com/infiquetra/talaria"
  version "0.7.1"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/infiquetra/talaria/releases/download/v0.7.1/talaria-0.7.1-aarch64-apple-darwin.tar.gz"
      sha256 "1111111111111111111111111111111111111111111111111111111111111111"
    end
    on_intel do
      url "https://github.com/infiquetra/talaria/releases/download/v0.7.1/talaria-0.7.1-x86_64-apple-darwin.tar.gz"
      sha256 "2222222222222222222222222222222222222222222222222222222222222222"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/infiquetra/talaria/releases/download/v0.7.1/talaria-0.7.1-aarch64-unknown-linux-musl.tar.gz"
      sha256 "4444444444444444444444444444444444444444444444444444444444444444"
    end
    on_intel do
      url "https://github.com/infiquetra/talaria/releases/download/v0.7.1/talaria-0.7.1-x86_64-unknown-linux-musl.tar.gz"
      sha256 "3333333333333333333333333333333333333333333333333333333333333333"
    end
  end

  def install
    bin.install "talaria"
  end

  def caveats
    <<~EOS
      Talaria needs a running Hermes gateway, v0.22.3 or newer.
      Run `talaria doctor` to check the connection and versions.
    EOS
  end

  test do
    assert_equal "talaria #{version}", shell_output("#{bin}/talaria --version").strip
  end
end
